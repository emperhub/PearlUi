function Section:Slider(options)
	options = options or {}
	local control, window = self:_row(options, "Slider")
	local minimum, maximum, step = options.Min or 0, options.Max or 100, options.Step or 1
	assert(finite(minimum) and finite(maximum) and finite(step), "Slider limits and step must be finite numbers")
	assert(maximum > minimum and step > 0, "Slider requires Max > Min and Step > 0")
	control.Validate = function(value)
		assert(type(value) == "number" and value == value and math.abs(value) ~= math.huge, "Slider expects a finite number")
		local result = minimum + math.round((math.clamp(value, minimum, maximum) - minimum) / step) * step
		return math.clamp(math.round(result * 1e6) / 1e6, minimum, maximum)
	end
	control.Value = control.Validate(options.Default or minimum)
	local track = button(control.Row, "")
	track.Name, track.Size, track.Position, track.ZIndex = "Slider", UDim2.fromOffset(134, 30), UDim2.new(1, -198, 0.5, -15), 11
	window:_feedback(track, { NoScale = true, Radius = 8 })
	local rail = make("Frame", { Name = "Rail", Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 0.5, -2), BorderSizePixel = 0, ZIndex = 12 }, track)
	window:_skin(rail, "BackgroundColor3", "Track"); corner(rail, 4)
	local fill = make("Frame", { Name = "Fill", Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, ZIndex = 13 }, rail)
	window:_skin(fill, "BackgroundColor3", "Accent"); corner(fill, 4)
	local thumb = make("Frame", { Name = "Thumb", Size = UDim2.fromOffset(15, 15), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 14 }, rail)
	window:_border(thumb, 15)
	local thumbScale = make("UIScale", { Scale = 1 }, thumb)
	window:_connect(track.MouseEnter, function() window:_tween(thumbScale, { Scale = 1.14 }, 0.55) end)
	window:_connect(track.MouseLeave, function() if not window._slider or window._slider.control ~= control then window:_tween(thumbScale, { Scale = 1 }, 0.55) end end)
	local valueText = window:_text(control.Row, "", 11, false, "Muted")
	control.ValueText = valueText
	valueText.Position, valueText.Size, valueText.TextXAlignment, valueText.ZIndex = UDim2.new(1, -56, 0, 0), UDim2.new(0, 56, 1, 0), Enum.TextXAlignment.Right, 11
	function control:_render()
		local ratio = (self.Value - minimum) / (maximum - minimum)
		if window._slider and window._slider.control == self then
			window:_stop(fill, "Size"); window:_stop(thumb, "Position")
			fill.Size, thumb.Position = UDim2.fromScale(ratio, 1), UDim2.fromScale(ratio, 0.5)
		else
			window:_tween(fill, { Size = UDim2.fromScale(ratio, 1) })
			window:_tween(thumb, { Position = UDim2.fromScale(ratio, 0.5) })
		end
		valueText.Text = tostring(self.Value) .. (options.Suffix or "")
	end
	control.Min,control.Max,control.Step = minimum,maximum,step
	window._gamepadAdjust[track] = function(x) if x==0 then return false end; if control:CanInteract() then control:Set(control.Value+x*step) end; return true end
	track.NextSelectionLeft,track.NextSelectionRight = track,track
	local function update(x)
		local ratio = math.clamp((x - rail.AbsolutePosition.X) / math.max(1, rail.AbsoluteSize.X), 0, 1)
		local nextValue = control.Validate(minimum + (maximum - minimum) * ratio)
		if nextValue ~= control.Value then control:Set(nextValue) end
	end
	window:_connect(track.InputBegan, function(input)
		if not control:CanInteract() then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local releaseScroll = input.UserInputType == Enum.UserInputType.Touch and window:_touchScrollLock(control) or function() end
			window._slider = { input = input, control = control, update = update, finish = function() releaseScroll(); window:_tween(thumbScale, { Scale = 1 }, 0.55) end }
			window:_tween(thumbScale, { Scale = 1.2 }, 0.55)
			update(input.Position.X)
		end
	end)
	control:_render()
	return control:_complete()
end

function Window:_openControlPopup(control, name, width, height, arrow)
	self:_cancelInteractions()
	local anchor = control.Field
	local popupScale = math.min(1,(self._rootWidth-16)/width,(self._rootHeight-16)/height)
	local visibleWidth,visibleHeight = width*popupScale,height*popupScale
	local position = (anchor.AbsolutePosition - self.Root.AbsolutePosition) / self._actualScale
	local below = position.Y + anchor.AbsoluteSize.Y / self._actualScale + 5
	local y = below + visibleHeight > self._rootHeight - 8 and position.Y - visibleHeight - 5 or below
	local popup = make("Frame", {
		Name = name, Position = UDim2.fromOffset(math.clamp(position.X, 8, math.max(8, self._rootWidth - visibleWidth - 8)), math.clamp(y,8,math.max(8,self._rootHeight-visibleHeight-8))),
		Size = UDim2.fromOffset(width, height), BorderSizePixel = 0, ZIndex = 101,
	}, self.Root)
	if popupScale < 1 then make("UIScale",{Name="PopupFit",Scale=popupScale},popup) end
	self:_surface(popup, "Card"); self:_border(popup, 11); self:_selectionGroup(popup)
	self._popup, self._popupAnchor, self._popupArrow, self._popupOwner = popup, anchor, arrow, control
	if arrow then self:_tween(arrow, { Rotation = 180 }, 0.7) end
	self.MenuDismiss.Visible = true
	local parent = anchor.Parent
	while parent and parent ~= self.Root do
		if parent:IsA("ScrollingFrame") then
			self._popupScrollConnection = self:_connect(parent:GetPropertyChangedSignal("CanvasPosition"), function() if self._popup == popup then self:_closeMenu() end end)
			break
		end
		parent = parent.Parent
	end
	return popup
end

function Window:_dropdownPopup(control)
	local searchable, touch = control.Searchable, self._touchTargets
	local rowHeight = touch and 44 or 30
	local paged = #control.Options > control.PageSize
	local top = searchable and (touch and 58 or 46) or 8
	local pageBar = paged and (touch and 48 or 34) or 0
	local footer = control.Multi and (touch and 52 or 42) or 8
	local listHeight = math.max(rowHeight, math.min(#control.Options * (rowHeight+2)+4, touch and 232 or 196, self._rootHeight-top-pageBar-footer-20))
	local menu = self:_openControlPopup(control, "SearchDropdown", math.min(286,self._rootWidth-16),top+listHeight+pageBar+footer,control.Arrow)
	local state = {Frame=menu,Rows={},Page=1,Matches={},PageCount=1}
	control._menu = state
	if searchable then
		state.Search = make("TextBox", {Name="SearchOptions",Text="",PlaceholderText="Search options…",ClearTextOnFocus=false,Font=FONT,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left,BorderSizePixel=0,Position=UDim2.fromOffset(8,8),Size=UDim2.new(1,-16,0,touch and 44 or 30),ZIndex=103},menu)
		self:_skin(state.Search,"BackgroundColor3","Field");self:_skin(state.Search,"TextColor3","Text");self:_skin(state.Search,"PlaceholderColor3","Muted")
		self:_border(state.Search,FIELD_RADIUS);padding(state.Search,10,0);self:_focusFeedback(state.Search)
	end
	state.List=make("ScrollingFrame",{Name="Options",BackgroundTransparency=1,BorderSizePixel=0,Position=UDim2.fromOffset(8,top),Size=UDim2.new(1,-16,0,listHeight),AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),ScrollBarThickness=3,ScrollingDirection=Enum.ScrollingDirection.Y,ZIndex=102},menu)
	list(state.List,2)
	state.Empty=self:_text(state.List,"No matching options",11,false,"Muted")
	state.Empty.Name,state.Empty.Size,state.Empty.ZIndex="Empty",UDim2.new(1,0,0,rowHeight),104
	local rebuild
	if paged then
		state.Previous, state.Next = button(menu,"‹"),button(menu,"›")
		state.PageLabel=self:_text(menu,"",10,false,"Muted")
		local y=top+listHeight+2
		state.PageLabel.Position,state.PageLabel.Size,state.PageLabel.ZIndex=UDim2.fromOffset(56,y),UDim2.new(1,-112,0,pageBar-4),103
		state.PageLabel.TextXAlignment=Enum.TextXAlignment.Center
		for i,b in ipairs({state.Previous,state.Next}) do
			b.Name=i==1 and "PreviousPage" or "NextPage"
			b.Position=i==1 and UDim2.fromOffset(8,y) or UDim2.new(1,-52,0,y)
			b.Size,b.ZIndex,b.BackgroundTransparency=UDim2.fromOffset(44,pageBar-4),103,0
			self:_skin(b,"TextColor3","Text");self:_skin(b,"BackgroundColor3","Field");self:_border(b,6);self:_feedback(b)
			self:_connect(b.Activated,function()
				if self._popup~=menu then return end
				state.Page=math.clamp(state.Page+(i==1 and -1 or 1),1,state.PageCount);rebuild()
			end)
		end
	end
	if control.Multi then
		state.Count=self:_text(menu,"",10,false,"Muted")
		state.Count.Position,state.Count.Size,state.Count.ZIndex=UDim2.new(0,12,1,-footer+4),UDim2.fromOffset(100,footer-10),103
		local clear,done=button(menu,"Clear"),button(menu,"Done")
		clear.Name,done.Name="ClearSelection","Done"
		for _,e in ipairs({{clear,-132,54},{done,-72,64}}) do
			local b=e[1];b.Position,b.Size,b.ZIndex,b.BackgroundTransparency=UDim2.new(1,e[2],1,-footer+4),UDim2.fromOffset(e[3],footer-10),103,0
			self:_skin(b,"BackgroundColor3","Field");self:_skin(b,"TextColor3","Text");self:_border(b,6);self:_feedback(b)
		end
		self:_connect(clear.Activated,function()if self._popup==menu and control:CanInteract() then control:Set({}) end end)
		self:_connect(done.Activated,function()if self._popup==menu then self:_closeMenu() end end)
	end
	rebuild=function()
		if self._popup~=menu then return end
		local selected=GuiService.SelectedObject
		local refocus=selected and selected:IsDescendantOf(state.List)
		for _,row in pairs(state.Rows) do row.Button:Destroy() end
		state.Rows={}
		state.PageCount=math.max(1,math.ceil(#state.Matches/control.PageSize))
		state.Page=math.clamp(state.Page,1,state.PageCount)
		state.Empty.Visible=#state.Matches==0
		local start=(state.Page-1)*control.PageSize+1
