--!nocheck
return function(PearlUI)
	local window = PearlUI.new({ Name = "PearlDockTest", ReduceMotion = true, AnimationSpeed = 0.1 })
	local checks = {}
	local function check(name, condition) assert(condition, "FAILED: " .. name); table.insert(checks, name) end
	local ok, result = pcall(function()
		window:Tab("General"):Section("Test"):Label("Dock test")
		window:SetMinimized(true)
		check("dock owns full-height layer", window.Dock.Parent == window.DockRoot and window.DockGui.IgnoreGuiInset and window._dockHeight >= window._rootHeight)
		window:StowDock("Left")
		check("left edge hides whole dock", window._dockSide == "Left" and not window.Dock.Visible and window.Dock.Position.X.Offset + window.Dock.Size.X.Offset / 2 < 0)
		check("left recovery handle visible", window.DockHandle.Visible and window.DockHandle.Position.X.Offset == 0)
		window:RevealDock()
		check("reveal left keeps window minimized", window.Dock.Visible and not window.DockHandle.Visible and not window._dockSide and window.Minimized and not window.Main.Visible)
		window:StowDock("Right")
		check("right edge hides whole dock", window._dockSide == "Right" and window.Dock.Position.X.Offset - window.Dock.Size.X.Offset / 2 > window._dockWidth)
		check("right recovery handle visible", window.DockHandle.Visible and math.abs(window.DockHandle.Position.X.Offset - (window._dockWidth - 22)) < 1)
		window:SetVisible(false); window:SetVisible(true)
		check("stowed side survives visibility", window._dockSide == "Right" and window.DockHandle.Visible and not window.Dock.Visible)
		window:_layout()
		check("stowed handle follows layout", math.abs(window.DockHandle.Position.X.Offset - (window._dockWidth - 22)) < 1 and not window.Dock.Visible)
		window:_beginDrag({ UserInputType = Enum.UserInputType.MouseButton1, Position = Vector3.new(600, 200, 0) }, window.Dock, 6)
		window:_updatePointer({ UserInputType = Enum.UserInputType.MouseMovement, Position = Vector3.new(500, 230, 0) })
		check("handle drag pulls dock out", not window._dockSide and window.Dock.Visible and window._dragging.moved)
		window:_endPointer({ UserInputType = Enum.UserInputType.MouseButton1 })
		check("pulling inward leaves dock expanded", not window._dockSide and window.Dock.Visible and window.Minimized)
		window:_beginDrag({ UserInputType = Enum.UserInputType.MouseButton1, Position = Vector3.new(500, 200, 0) }, window.Dock, 6)
		window:_updatePointer({ UserInputType = Enum.UserInputType.MouseMovement, Position = Vector3.new(-10000, 200, 0) })
		window:_endPointer({ UserInputType = Enum.UserInputType.MouseButton1 })
		check("drag release auto stows left", window._dockSide == "Left" and window.DockHandle.Visible and not window.Dock.Visible)
		window:RevealDock()
		window:_beginDrag({ UserInputType = Enum.UserInputType.MouseButton1, Position = Vector3.new(200, 200, 0) }, window.Dock, 6)
		window:_updatePointer({ UserInputType = Enum.UserInputType.MouseMovement, Position = Vector3.new(10000, 200, 0) })
		window:_endPointer({ UserInputType = Enum.UserInputType.MouseButton1 })
		check("drag release auto stows right", window._dockSide == "Right" and window.DockHandle.Visible)
		window:SetMinimized(false)
		check("opening window hides recovery handle", not window.Dock.Visible and not window.DockHandle.Visible and window.Main.Visible)
		window:SetMinimized(true)
		check("minimizing restores recovery handle", window.DockHandle.Visible and window._dockSide == "Right")
		window.ReduceMotion = false
		window:RevealDock(); task.wait(0.025); window:StowDock("Left"); task.wait(0.025); window:RevealDock(); task.wait(0.2)
		check("rapid edge animation keeps latest state", not window._dockSide and window.Dock.Visible and not window.DockHandle.Visible and window.Dock.Position.X.Offset >= window.Dock.Size.X.Offset / 2)
		window:StowDock("Right"); window:Destroy(); task.wait(0.15)
		check("edge layer destroyed with window", window.DockGui.Parent == nil and window.Gui.Parent == nil and next(window._tweens) == nil)
		return { passed = #checks, checks = checks }
	end)
	window:Destroy()
	if not ok then error(result) end
	return result
end
