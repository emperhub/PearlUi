--!nocheck
return function(PearlUI)
	local checks,windows={},{}
	local function check(n,v)assert(v,"FAILED: "..n);table.insert(checks,n)end
	local Http=game:GetService("HttpService")
	local function fixture(scope)
		local w=PearlUI.new({Name="PearlConfigTest",ReduceMotion=true,ConfigScope=scope or "game_a"});table.insert(windows,w)
		local t=w:Tab("General");w:Tab("Profiles")
		local s=t:Section("Controls")
		local flag=s:Toggle({Id="flag",Default=false})
		local choice=s:Dropdown({Id="theme",ResetGroup="Appearance",Options=PearlUI.GetThemes(),Default="Light",Callback=function(v)w:SetTheme(v)end})
		local transient=s:Input({Id="configName",Persist=false,Default="Name"})
		w:CaptureDefaults()
		return w,flag,choice,transient
	end
	local ok,result=pcall(function()
		local w,flag,theme,transient=fixture()
		local events=0;local connection=w:OnConfigsChanged(function()events+=1 end)
		assert(w:CreateConfig("  Farm  "));check("create trims names and stores snapshot",w._profiles.Farm~=nil and w._profiles["  Farm  "]==nil)
		check("created config becomes active and clean",w:GetConfigStatus().Active=="Farm" and not w:GetConfigStatus().Dirty)
		check("transient manager fields excluded",Http:JSONDecode(w._profiles.Farm).Values.configName==nil)
		transient:Set("Typed text");w:SelectTab("Profiles")
		check("manager typing and tab navigation do not mark config dirty",not w:GetConfigStatus().Dirty)
		flag:Set(true);check("changed control marks active config edited",w:GetConfigStatus().Dirty)
		assert(w:SaveConfig("Farm"));check("save updates snapshot and clears edited state",not w:GetConfigStatus().Dirty and Http:JSONDecode(w._profiles.Farm).Values.flag)
		check("case-insensitive duplicate rejected",not w:CreateConfig("farm"))
		check("empty and control-character names rejected",not w:CreateConfig("  ") and not w:CreateConfig("bad\nname"))
		check("long names rejected",not w:CreateConfig(string.rep("a",33)))
		assert(w:CreateConfig("ฟาร์ม"));check("unicode names supported",w._profiles["ฟาร์ม"]~=nil)
		assert(w:SetAutoLoadConfig("Farm"));assert(w:RenameConfig("Farm","Gather"))
		check("rename moves stored data without changing live values",w._profiles.Farm==nil and w._profiles.Gather~=nil and flag:Get())
		check("renaming another config preserves active selection",w:GetConfigStatus().Active=="ฟาร์ม")
		check("rename updates auto-load reference",w:GetConfigStatus().AutoLoad=="Gather")
		check("rename collision rejected",not w:RenameConfig("Gather","ฟาร์ม") and w._profiles.Gather~=nil)
		flag:Set(false);assert(w:LoadConfig("Gather"))
		check("load applies saved values and sets active",flag:Get() and w:GetConfigStatus().Active=="Gather")
		local exported=assert(w:ExportConfig("Gather"));local doc=Http:JSONDecode(exported)
		check("export is versioned and scope-tagged",doc.Kind=="PearlUIConfig" and doc.Version==1 and doc.Scope=="game_a")
		check("export contains one config only",doc.Profile.Values.flag and doc.Profiles==nil)
		flag:Set(false);local before=flag:Get();assert(w:ImportConfig("Imported",exported))
		check("import stores without applying values",flag:Get()==before and w._profiles.Imported~=nil)
		check("import preserves active config",w:GetConfigStatus().Active=="Gather")
		check("import requires explicit overwrite",not w:ImportConfig("Imported",exported))
		assert(w:ImportConfig("Imported",exported,true));check("explicit overwrite succeeds",w._profiles.Imported~=nil)
		local corrupt=Http:JSONDecode(exported);corrupt.Profile.Values.theme="UnknownTheme"
		local old=w._profiles.Imported
		check("invalid values reject import atomically",not w:ImportConfig("Imported",Http:JSONEncode(corrupt),true) and w._profiles.Imported==old and not flag:Get())
		check("malformed JSON and future version rejected",not w:ValidateConfig("{bad") and not w:ValidateConfig('{"Kind":"PearlUIConfig","Version":999}'))
		check("oversized transfer rejected",not w:ValidateConfig(string.rep("a",100001)))
		assert(w:ImportConfig("Legacy",w:ExportProfile()));check("legacy profile JSON imports",w._profiles.Legacy~=nil)
		local h=w:Confirm({Title="Import",Text="bad",Validate=function(raw)return w:ValidateConfig(raw)end,OnConfirm=function(raw)assert(w:ImportConfig("Dialog",raw))end})
		h:Confirm();check("invalid editor remains open with error",h.Pending and h.ErrorLabel.Text~="" and w._profiles.Dialog==nil)
		h.Editor.Text=exported;h:Confirm();check("valid editor confirms and imports",not h.Pending and w._profiles.Dialog~=nil)
		h=w:Confirm({Text=exported,ReadOnly=true,ConfirmText="Done"});check("export editor uses readonly field",not h.Editor.TextEditable);h:Cancel()
		local current=flag:Get();assert(w:DeleteConfig("Gather"))
		check("delete clears active and auto-load references",w:GetConfigStatus().Active==nil and w:GetConfigStatus().AutoLoad==nil)
		check("delete leaves current values intact",flag:Get()==current)
		check("missing config operations reject",not w:LoadConfig("Missing") and not w:SaveConfig("Missing") and not w:DeleteConfig("Missing"))
		local beforeEvents=events;connection:Disconnect();assert(w:CreateConfig("After disconnect"));check("config listeners disconnect cleanly",events==beforeEvents)
		local disk={};local adapter={Load=function(k)return disk[k]end,Save=function(k,v)disk[k]=v;return true end}
		assert(w:ConfigurePersistence({Adapter=adapter,Key="test",Load=false,AutoSave=false}))
		theme:Set("Forest");flag:Set(true);assert(w:CreateConfig("Start"));assert(w:SetAutoLoadConfig("Start"));theme:Set("Rose");flag:Set(false)
		assert(w:SaveSettings())
		local restored,rFlag=fixture("game_a");assert(restored:ConfigurePersistence({Adapter=adapter,Key="test",AutoSave=false}))
		check("auto-load overrides last transient setup on startup",restored.Theme=="Forest" and rFlag:Get() and restored:GetConfigStatus().Active=="Start")
		check("auto-load choice persists",restored:GetConfigStatus().AutoLoad=="Start")
		local other,oFlag=fixture("game_b");assert(other:ConfigurePersistence({Adapter=adapter,Key="test",AutoSave=false}))
		check("different game has isolated config list",#other:ListConfigs()==0 and other:GetConfigStatus().AutoLoad==nil)
		check("different game does not inherit control values",other.Theme=="Light" and not oFlag:Get())
		assert(other:CreateConfig("Other game"));assert(other:SaveSettings())
		local returnA=fixture("game_a");assert(returnA:ConfigurePersistence({Adapter=adapter,Key="test",AutoSave=false}))
		check("saving another game preserves earlier game bank",returnA._profiles.Start~=nil and returnA._profiles["Other game"]==nil)
		local legacy={Version=1,Current=Http:JSONDecode(w:ExportProfile()),Profiles={Old=w:ExportProfile()}}
		disk.legacy=Http:JSONEncode(legacy)
		local migrated=fixture("game_legacy");assert(migrated:ConfigurePersistence({Adapter=adapter,Key="legacy",AutoSave=false}))
		check("old saved profiles migrate into current game",migrated._profiles.Old~=nil and migrated:GetConfigStatus().Scope=="game_legacy")
		local raw=Http:JSONDecode(disk.test);raw.Configurations.Banks.game_a.AutoLoad="Missing";disk.invalid=Http:JSONEncode(raw)
		local bad=fixture("game_a");check("invalid auto-load rejects whole storage document",not bad:ConfigurePersistence({Adapter=adapter,Key="invalid",AutoSave=false}) and bad.Theme=="Light")
		local empty=fixture("empty");assert(empty:ImportConfig("Only",exported));check("import into empty scope does not fake active selection",empty:GetConfigStatus().Active==nil)
		local returned=empty:ListConfigs();returned[1]="Changed";check("config list is defensive",empty:ListConfigs()[1]=="Only")
		local cap=fixture("capacity")
		for i=1,20 do assert(cap:CreateConfig("Config "..i))end
		check("twenty-config limit rejects without mutation",not cap:CreateConfig("Overflow") and #cap:ListConfigs()==20 and cap._profiles.Overflow==nil)
		assert(cap:DeleteConfig("Config 1"));check("removing one config frees capacity",cap:CreateConfig("Replacement"))
		local legacyLong=string.rep("a",60);legacy.Profiles[legacyLong]=w:ExportProfile();disk.long=Http:JSONEncode(legacy)
		local long=fixture("long");assert(long:ConfigurePersistence({Adapter=adapter,Key="long",AutoSave=false}))
		check("legacy long names survive migration",long._profiles[legacyLong]~=nil)
		local noMeta=Http:JSONDecode(w:ExportProfile());noMeta.Values.configName=42
		local unchanged=transient:Get();assert(w:ImportProfile(Http:JSONEncode(noMeta)))
		check("old transient manager values cannot alter text fields",transient:Get()==unchanged)
		return {passed=#checks,checks=checks}
	end)
	for _,w in ipairs(windows)do w:Destroy()end
	if not ok then error(result)end;return result
end
