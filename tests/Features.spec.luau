--!nocheck
return function(PearlUI)
	local Http = game:GetService("HttpService")
	local window = PearlUI.new({ Name = "PearlFeaturesTest", ReduceMotion = true })
	local checks = {}
	local function check(name, condition) assert(condition, "FAILED: " .. name); table.insert(checks, name) end
	local ok, result = pcall(function()
		local first, other = window:Tab("General"), window:Tab("Other")
		local section = first:Section({ Title = "Controls", Id = "controls" })
		local extra = other:Section({ Title = "Palette", Id = "palette" })
		local flag = section:Toggle({ Id = "flag", Label = "Enabled" })
		local action = section:Button({ Label = "Action", Text = "Run" })
		local multi = section:Dropdown({ Id = "multi", Label = "Multiple", Multi = true, Options = { "Alpha", "Beta", "Gamma" }, Default = { "Beta" } })
		local single = section:Dropdown({ Id = "single", Label = "Single", Options = { "One", "Two", "Three" } })
		local lastColor, lastAlpha, colorCalls
		colorCalls = 0
		local picker = extra:ColorPicker({ Id = "color", Label = "Accent", Default = "#08F", Alpha = 0.7, Callback = function(color, alpha)
			lastColor, lastAlpha, colorCalls = color, alpha, colorCalls + 1
			window:SetAccent(color)
		end })
		task.wait(0.1)
		flag:SetLabel("Renamed enabled")
		check("control label API preserves ID", flag.LabelText.Text == "Renamed enabled" and flag.Id == "flag" and window._ids.flag == flag)
		flag:SetVisible(false); window.Search.Text = "Renamed"
		check("explicitly hidden stays hidden during search", not flag.Row.Visible)
		window.Search.Text = ""; flag:SetVisible(true)
		check("control visibility restores", flag.Row.Visible)
		action:SetDisabled(true, "Requires an enabled setting")
		check("disabled native button", action.DisabledOverlay.Visible and not action.Row.Button.Interactable and not action:CanInteract())
		window:_disabledTooltip(action)
		check("disabled reason is visible", window._tooltip and window._tooltip.Text == "Requires an enabled setting")
		action:SetDisabled(false)
		check("reenabled control", action.Row.Button.Interactable and action:CanInteract())
		window:_hideTooltip()
		local temp = section:Toggle({ Id = "temporary", Label = "Temporary" })
		local connectionsBefore = #window._connections
		temp:Destroy(); temp:Destroy()
		check("destroy removes ID and refresh closure", window._ids.temporary == nil and window._refresh[temp] == nil and temp.Row.Parent == nil)
		check("destroy disconnects owned handlers", #window._connections < connectionsBefore and #temp._ownedConnections == 0)
		check("destroyed setter rejected", not pcall(function() temp:Set(true) end))
		local replacement = section:Toggle({ Id = "temporary", Label = "Replacement" })
		check("destroyed ID can be reused", window._ids.temporary == replacement)
		local values = multi:Get(); values[1] = "Gamma"
		check("multi get is defensive", multi:Get()[1] == "Beta")
		multi:Set({ "Gamma", "Alpha", "Alpha" })
		check("multi selection canonicalized", #multi:Get() == 2 and multi:Get()[1] == "Alpha" and multi:Get()[2] == "Gamma")
		local before = Http:JSONEncode(multi:Get())
		check("invalid multi selection rejected", not pcall(function() multi:Set({ "Unknown" }) end) and Http:JSONEncode(multi:Get()) == before)
		multi:Open()
		local menu = multi._menu
		check("searchable multi popup opens", window._popupOwner == multi and menu.Search ~= nil)
		menu.Search.Text = "beta"; task.wait()
		check("dropdown search filters without changing selection", menu.Rows.Beta.Button.Visible and not menu.Rows.Alpha.Button.Visible and #multi:Get() == 2)
		menu.Search.Text = "missing"; task.wait()
		check("dropdown empty state", menu.Empty.Visible)
		multi:Set({ "Beta" })
		check("multi selection keeps popup open", window._popup == menu.Frame and menu.Rows.Beta.Check.Visible and menu.Count.Text == "1 selected")
		multi:SetDisabled(true, "Disabled for test")
		check("disabling closes owned popup", window._popup == nil and multi._menu == nil)
		multi:Open(); check("disabled popup cannot open", window._popup == nil)
		multi:SetDisabled(false)
		multi:Set({ "Alpha", "Gamma" }); multi:SetOptions({ "Alpha", "Delta" })
		check("option replacement preserves valid selections", #multi:Get() == 1 and multi:Get()[1] == "Alpha")
		local oldOptions = table.concat(multi.Options, ",")
		check("invalid replacement is atomic", not pcall(function() multi:SetOptions({ "New" }, { "Invalid" }) end) and table.concat(multi.Options, ",") == oldOptions)
		check("duplicate options rejected", not pcall(function() multi:SetOptions({ "A", "A" }) end))
		check("mapped option tables rejected", not pcall(function() multi:SetOptions({ "A", name = "B" }) end))
		single:Open(); check("single dropdown is searchable", single._menu.Search ~= nil); single:Close()
		picker:Set("#0F8")
		local color, alpha = picker:Get()
		check("HEX shorthand normalized", picker.Value.Hex == "#00FF88" and math.abs(alpha - 0.7) < 0.001)
		check("color callback has color and alpha", typeof(lastColor) == "Color3" and lastAlpha == 0.7 and colorCalls > 0)
		picker:SetAlpha(0.35)
		check("color alpha API", select(2, picker:Get()) == 0.35)
		local encoded = Http:JSONEncode(picker:Serialize())
		check("invalid HEX rejected without mutation", not pcall(function() picker:Set("#ZZ0000") end) and Http:JSONEncode(picker:Serialize()) == encoded)
		check("invalid alpha rejected", not pcall(function() picker:SetAlpha(2) end) and select(2, picker:Get()) == 0.35)
		local previousHue = picker._hue
		check("missing HSV channel is atomic", not pcall(function() picker:SetHSV(0.9, nil, 1) end) and picker._hue == previousHue and Http:JSONEncode(picker:Serialize()) == encoded)
		window:SelectTab(other); picker:Open(); task.wait()
		local colors = picker._menu
		check("color popup contains editors", colors.Hex ~= nil and colors.R ~= nil and colors.Alpha ~= nil)
		local inset = game:GetService("GuiService"):GetGuiInset()
		colors.UpdateSV(colors.SV.AbsolutePosition.X + inset.X + colors.SV.AbsoluteSize.X * 0.5, colors.SV.AbsolutePosition.Y + inset.Y + colors.SV.AbsoluteSize.Y * 0.2)
		local _, saturation, value = picker:Get():ToHSV()
		check("SV pointer uses InputObject coordinate origin", math.abs(saturation - 0.5) < 0.01 and math.abs(value - 0.8) < 0.01)
		colors.UpdateAlpha(colors.Alpha.AbsolutePosition.X + inset.X + colors.Alpha.AbsoluteSize.X * 0.25, colors.Alpha.AbsolutePosition.Y + inset.Y)
		check("alpha pointer updates value", math.abs(select(2, picker:Get()) - 0.25) < 0.01)
		colors.UpdateHue(colors.Hue.AbsolutePosition.X + inset.X + colors.Hue.AbsoluteSize.X * 0.6, colors.Hue.AbsolutePosition.Y + inset.Y)
		check("accent callback keeps picker open", window._popup == colors.Frame and picker._menu == colors)
		window:SetTheme("Dark")
		check("theme update keeps picker open", window._popup == colors.Frame)
		picker:SetVisible(false)
		check("hiding color control closes editor", window._popup == nil)
		picker:SetVisible(true); picker:Open(); picker:Destroy()
		check("destroying open picker cleans state", window._popup == nil and window._ids.color == nil and window._refresh[picker] == nil)
		picker = extra:ColorPicker({ Id = "color", Label = "Saved color", Default = "#AABBCC", Alpha = 0.6 })
		window:SetSize(760, 500); window.Main.Position = UDim2.fromOffset(8, 36)
		extra:Detach(); task.wait()
		extra.Float.Position = UDim2.fromOffset(100, 130)
		window.Dock.Position = UDim2.fromOffset(window._dockWidth * 0.55, window._dockHeight * 0.35)
		window._dockMoved = true
		window:SetMinimized(true); window:StowDock("Right")
		local profile = window:ExportProfile()
		local data = Http:JSONDecode(profile)
		check("profile color encoded as HEX", data.Values.color.Hex == "#AABBCC" and data.Values.color.Alpha == 0.6)
		check("profile contains complete layout", data.Layout.Version == 1 and data.Layout.Dock.Side == "Right" and data.Layout.Panels.palette.Detached)
		picker:Set("#000000"); multi:Set({ "Delta" }); extra:Dock(); window:RevealDock(); window:SetMinimized(false); window:SetSize(900, 610); window:SelectTab(first)
		local restored, message = window:ImportProfile(profile)
		check("profile with layout imports", restored == true)
		check("profile restores new control values", picker.Value.Hex == "#AABBCC" and multi:Get()[1] == "Alpha")
		check("layout restores window size and active tab", window.WindowSize == Vector2.new(760, 500) and window.ActiveTab == other)
		check("layout restores detached panel", extra.Detached and extra.Frame.Parent == extra.FloatScroll and math.abs(extra.Float.Position.X.Offset - 100) < 1 and math.abs(extra.Float.Position.Y.Offset - 130) < 1)
		check("layout restores stowed dock", window._dockSide == "Right" and window.Minimized and window.DockHandle.Visible)
		local beforeFlag = flag:Get()
		local invalid = Http:JSONDecode(profile); invalid.Layout.Window.Width = 0; invalid.Values.flag = not beforeFlag
		check("invalid layout rejects whole profile before mutation", not window:ImportProfile(Http:JSONEncode(invalid)) and flag:Get() == beforeFlag and window.WindowSize.X == 760)
		local invalidPanel = window:GetLayout(); invalidPanel.Panels.palette.X = nil
		check("invalid panel position rejected", not window:ImportLayout(invalidPanel))
		local layout = window:ExportLayout()
		window:SetScale(0.8)
		check("layout imports in new scale", window:ImportLayout(layout) and math.abs(window.DockHandle.Position.X.Offset - (window._dockWidth - 22)) < 1)
		local beforeLegacy = window.WindowSize
		check("legacy profiles remain supported", window:ImportProfile(Http:JSONEncode({ Version = 1, Values = { flag = true }, Appearance = { Theme = "Light" } })) and flag:Get() and window.WindowSize == beforeLegacy)
		check("layout JSON is independent", window:GetLayout() ~= window:GetLayout())
		extra:Dock(); extra:Detach(); task.wait()
		local added = extra:Button({ Label = "Added while detached" })
		check("new detached control uses correct layer", added.Row.ZIndex == 50)
		extra:Dock()
		check("docking restores new control layer", added.Row.ZIndex == 8)
		window:Destroy()
		check("window destruction invalidates handles", flag.Destroyed and not pcall(function() flag:Set(false) end))
		return { passed = #checks, checks = checks }
	end)
	window:Destroy()
	if not ok then error(result) end
	return result
end
