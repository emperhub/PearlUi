--!nocheck
-- Run as a client test after requiring PearlUI. Does not touch world state.
return function(PearlUI)
	local checks = {}
	local function check(name, condition)
		assert(condition, "FAILED: " .. name)
		table.insert(checks, name)
	end
	local window = PearlUI.new({ Name = "PearlUIRuntimeTest", ReduceMotion = true })
	local ok, result = pcall(function()
		local tab = window:Tab("General")
		local other = window:Tab("Appearance")
		local section = tab:Section("Interface")
		local second = other:Section("Palette")
		local calls = 0
		local toggle = section:Toggle({ Id = "enabled", Label = "Enabled", Callback = function() calls += 1 end })
		local slider = section:Slider({ Id = "amount", Label = "Amount", Min = 10, Max = 30, Step = 2, Default = 20 })
		local dropdown = section:Dropdown({ Id = "theme", Label = "Theme", Options = { "Light", "Dark" } })
		local input = section:Input({ Id = "name", Label = "Name", MaxLength = 3 })
		local keybind = section:Keybind({ Id = "key", Label = "Shortcut" })
		second:Label({ Label = "Other tab marker", Value = "Blue" })
		task.wait(0.15)
		check("GUI rendered", section.Frame.AbsoluteSize.Y > 100 and window.Main.AbsoluteSize.X > 100)
		check("dock starts flush top center", math.abs(window.Dock.Position.X.Offset - window._dockWidth / 2) < 1 and window.Dock.Position.Y.Offset == 0 and window.DockGui.IgnoreGuiInset and window.Dock.AnchorPoint == Vector2.new(0.5, 0))
		check("rounded sidebar mask", window.Sidebar.ClipsDescendants and window.Sidebar.BackgroundTransparency == 1 and window.Sidebar.SidebarBackground:FindFirstChildOfClass("UICorner").CornerRadius.Offset == 14)
		check("uniform chrome outline", window.Main.WindowOutline:FindFirstChildOfClass("UICorner").CornerRadius.Offset == window.Main.Shell:FindFirstChildOfClass("UICorner").CornerRadius.Offset)
		check("no extra bottom divider", not keybind.Separator.Visible and toggle.Separator.Visible)
		check("Lucide original icon data", tab.Icon:GetAttribute("LucideIcon") == "settings-2" and #tab.Icon:GetChildren() > 0)
		check("default state", toggle:Get() == false and slider:Get() == 20 and dropdown:Get() == "Light")
		toggle:Set(true); check("toggle callback", toggle:Get() == true and calls == 1)
		toggle:Set(false, true); check("silent setter", calls == 1)
		slider:Set(999); check("slider clamp", slider:Get() == 30)
		slider:Set(17); check("slider quantization", slider:Get() == 18)
		dropdown:Set("Dark"); check("dropdown change", dropdown:Get() == "Dark")
		local before = dropdown:Get()
		check("invalid dropdown rejected", not pcall(function() dropdown:Set("missing") end) and dropdown:Get() == before)
		input:Set("กขคง"); check("UTF-8 character limit", input:Get() == "กขค")
		keybind:Set(Enum.KeyCode.F2); check("keybind EnumItem", keybind:Get() == "F2")
		window:SetTheme("Dark"); check("dark theme", window.Theme == "Dark")
		window:SetAccent(Color3.fromRGB(200, 80, 160)); check("custom accent", window.Palette.Accent.R > 0.7)
		window:SetScale(1.2); window:SetOpacity(0.88)
		local json = window:ExportProfile()
		toggle:Set(true); slider:Set(12); input:Set("abc"); window:SetTheme("Light")
		local loaded = window:ImportProfile(json)
		check("profile roundtrip", loaded and toggle:Get() == false and slider:Get() == 18 and input:Get() == "กขค" and window.Theme == "Dark")
		local bad = game:GetService("HttpService"):JSONEncode({ Version = 1, Values = { enabled = true, amount = "invalid" } })
		local loadedBad = window:ImportProfile(bad)
		check("profile validation before mutations", not loadedBad and toggle:Get() == false and slider:Get() == 18)
		check("malformed profile rejected", not window:ImportProfile("{broken"))
		window:SaveProfile("Test"); slider:Set(10)
		check("named profile", window:LoadProfile("Test") and slider:Get() == 18)
		check("missing profile handled", not window:LoadProfile("Missing"))
		window.Search.Text = "Other tab marker"; task.wait()
		check("search spans tabs", second.Frame.Parent == tab.Page and second.Frame.Visible and not section.Frame.Visible)
		window.Search.Text = ""; task.wait()
		check("search restores ownership", second.Frame.Parent == other.Page and section.Frame.Parent == tab.Page)
		section:Detach(); task.wait()
		check("detached panel", section.Detached and section.Frame.Parent == section.FloatScroll and section.Float.Visible)
		window:SetVisible(false); check("hide includes panels", not section.Float.Visible and not window.Main.Visible and window.Dock.Visible)
		window:SetVisible(true); check("restore includes panels", section.Float.Visible and window.Main.Visible)
		window:SetMinimized(true); check("compact mode", not window.Main.Visible and window.Dock.Visible)
		window:SetMinimized(false); section:Dock(); task.wait()
		check("dock restores section", not section.Detached and section.Frame.Parent == tab.Page and not section.Float.Visible)
		window:SetMinimized(true)
		local dockStart = window.Dock.Position
		window:_beginDrag({ UserInputType = Enum.UserInputType.MouseButton1, Position = Vector3.new(200, 200, 0) }, window.Dock, 6)
		window:_updatePointer({ UserInputType = Enum.UserInputType.MouseMovement, Position = Vector3.new(202, 201, 0) })
		check("dock click threshold", window.Dock.Position == dockStart and window:_dockClickAllowed())
		window:_updatePointer({ UserInputType = Enum.UserInputType.MouseMovement, Position = Vector3.new(260, 230, 0) })
		check("dock follows drag", window.Dock.Position.X.Offset > dockStart.X.Offset and window.Dock.Position.Y.Offset > dockStart.Y.Offset and window._dockMoved)
		check("dock drag suppresses button activation", not window:_dockClickAllowed() and window.Minimized)
		window:_endPointer({ UserInputType = Enum.UserInputType.MouseButton1 })
		check("dock release suppresses accidental click", window._dragging == nil and not window:_dockClickAllowed())
		local movedDockPosition = window.Dock.Position
		window:_layout()
		check("dock position survives layout", window.Dock.Position == movedDockPosition)
		window:SetMinimized(false); window:SetMinimized(true)
		check("dock position survives restore minimize", window.Dock.Position == movedDockPosition)
		window.Dock.Position = UDim2.fromOffset(-1000, -1000); window:_clamp(window.Dock)
		check("dock stays in viewport", window.Dock.Position.X.Offset - window.Dock.Size.X.Offset / 2 == 8 and window.Dock.Position.Y.Offset == 0)
		window._dockClickUntil = 0
		check("dock click reenabled", window:_dockClickAllowed())
		window:SetMinimized(false)
		window:SetMaximized(true); check("maximize", window.Maximized)
		window:SetMaximized(false); check("restore size", window.Main.Size.X.Offset == 900)
		window:SetSize(760, 500)
		check("resize API", window.WindowSize == Vector2.new(760, 500) and window.Main.Size == UDim2.fromOffset(760, 500))
		window.Main.Position = UDim2.fromOffset(8, 8)
		window:_beginResize({ UserInputType = Enum.UserInputType.MouseButton1, Position = Vector3.new(200, 200, 0) })
		local scaleAtStart = window._actualScale
		window:_updatePointer({ UserInputType = Enum.UserInputType.MouseMovement, Position = Vector3.new(200 + 30 * scaleAtStart, 200 + 20 * scaleAtStart, 0) })
		local expectedWidth = math.min(790, math.round(math.max(window.MinSize.X, window._rootWidth - window.Main.Position.X.Offset - 8)))
		local expectedHeight = math.min(520, math.round(math.max(window.MinSize.Y, window._rootHeight - window.Main.Position.Y.Offset - 8)))
		check("resize from pointer delta", window.WindowSize == Vector2.new(expectedWidth, expectedHeight) and window._actualScale == scaleAtStart)
		window:_updatePointer({ UserInputType = Enum.UserInputType.MouseMovement, Position = Vector3.new(-10000, -10000, 0) })
		check("resize minimum size", window.WindowSize == window.MinSize)
		window:_endPointer({ UserInputType = Enum.UserInputType.MouseButton1 })
		check("resize ends on release", window._resizing == nil)
		window:SetMaximized(true)
		window:_beginResize({ UserInputType = Enum.UserInputType.MouseButton1, Position = Vector3.zero })
		check("maximize disables resizing", not window.ResizeHandle.Visible and window._resizing == nil)
		window:SetMaximized(false); window:SetSize(900, 610)
		dropdown:SetOptions({ "A", "B" }, "B"); check("replace dropdown options", dropdown:Get() == "B")
		window:SetToggleKey("F4"); check("toggle key update", window.ToggleKey == Enum.KeyCode.F4)
		local connectionsBefore, skinsBefore = #window._connections, #window._skins
		for _ = 1, 8 do
			window:_popupMenu(dropdown.Row.Dropdown, { "A", "B" }, "A", function() end)
			window:_closeMenu()
		end
		check("temporary menu cleanup", #window._connections == connectionsBefore and #window._skins == skinsBefore)
		check("invalid scale rejected", not pcall(function() window:SetScale(0 / 0) end))
		window:Notify({ Title = "Test", Duration = 0.05 }); task.wait(0.1)
		check("toast expires", window.Notifications:FindFirstChild("Toast") == nil)
		window:Destroy(); window:Destroy()
		check("idempotent cleanup", window.Destroyed and #window._connections == 0 and window.Gui.Parent == nil and window.DockGui.Parent == nil)
		return { passed = #checks, checks = checks }
	end)
	window:Destroy()
	if not ok then error(result) end
	return result
end
