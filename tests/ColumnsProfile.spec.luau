--!nocheck
return function(PearlUI)
	local window = PearlUI.new({ Name = "PearlColumnsTest", ReduceMotion = true })
	local checks = {}
	local function check(name, condition) assert(condition, "FAILED: " .. name); table.insert(checks, name) end
	local function settle() task.wait(0.08) end
	local ok, result = pcall(function()
		local tab, other = window:Tab("General"), window:Tab("Other")
		local left = tab:Section({ Title = "Left", Id = "left", Column = "Left" })
		local right = tab:Section({ Title = "Right", Id = "right", Column = "Right" })
		local lower = tab:Section({ Title = "Lower", Id = "lower", Column = "Left" })
		local foreign = other:Section({ Title = "Foreign", Id = "foreign", Column = "Right" })
		local toggle = left:Toggle({ Id = "toggle", Label = "Show notifications", Default = true })
		local choice = left:Dropdown({ Id = "choice", Label = "Theme selector", Options = { "Light", "Dark" } })
		local slider = right:Slider({ Id = "slider", Label = "Animation speed", Default = 50 })
		local input = right:Input({ Id = "input", Label = "Profile description", Description = "A helpful description", Default = "Default" })
		lower:Button({ Label = "Save preferences", Text = "Save" })
		foreign:Label({ Label = "Unique search marker", Value = "Other" })
		settle()
		check("two columns enabled by default", window.Columns == 2 and tab.EffectiveColumns == 2)
		check("right section sits beside left", right.Frame.Position.X.Offset > left.Frame.Position.X.Offset and right.Frame.Position.Y.Offset == left.Frame.Position.Y.Offset)
		check("same-column cards stack", lower.Frame.Position.X.Offset == left.Frame.Position.X.Offset and lower.Frame.Position.Y.Offset >= left:_measureHeight() + 15)
		check("column widths match", math.abs(left.Frame.Size.X.Offset - right.Frame.Size.X.Offset) <= 1)
		check("compact fields expand across card", choice._compactLayout and choice.Field.Size.X.Scale == 1 and choice.Row.Size.Y.Offset == 68)
		check("compact label stays above field", choice.LabelText.Position.Y.Offset + choice.LabelText.Size.Y.Offset <= choice.Field.Position.Y.Offset + choice.Row.Size.Y.Offset)
		check("compact toggle keeps readable label space", toggle.LabelText.Size.X.Offset == -60 and toggle.Row.Size.Y.Offset == 46)
		check("slider uses full card width", slider.Row.Slider.Size.X.Scale == 1 and slider.ValueText.Position.Y.Offset == 4)
		check("description stays above input", input.DescriptionText.Position.Y.Offset + input.DescriptionText.Size.Y.Offset <= input.Row.Size.Y.Offset + input.Row.Input.Position.Y.Offset)
		check("measured height matches rendered card", math.abs(left.Frame.AbsoluteSize.Y / window._actualScale - left:_measureHeight()) < 2)
		check("canvas covers tallest column", tab.Page.CanvasSize.Y.Offset >= math.max(lower.Frame.Position.Y.Offset + lower:_measureHeight(), right:_measureHeight()))
		window:SetSize(680, 500); settle()
		check("narrow window stacks columns", tab.EffectiveColumns == 1 and right.Frame.Position.X.Offset == 0 and right.Frame.Position.Y.Offset > left.Frame.Position.Y.Offset)
		window:SetSize(1440, 900); settle()
		check("wide window restores two columns", tab.EffectiveColumns == 2 and right.Frame.Position.X.Offset > 0)
		check("wide rows restore original field width", not choice._compactLayout and choice.Field.Size.X.Offset == 174 and choice.Row.Size.Y.Offset == 46)
		window:SetColumns(1); settle()
		check("single-column mode supported", tab.EffectiveColumns == 1 and right.Frame.Position.X.Offset == 0)
		local layout = window:ExportLayout()
		window:SetColumns(2); assert(window:ImportLayout(layout)); settle()
		check("layout restores column preference", window.Columns == 1 and tab.EffectiveColumns == 1)
		local legacy = window:GetLayout(); legacy.Window.Columns = nil
		window:SetColumns(2); assert(window:ImportLayout(legacy)); settle()
		check("old layouts keep current column preference", window.Columns == 2)
		window.Search.Text = "Unique search marker"; settle()
		check("search fills left column first", foreign.Frame.Parent == tab.Page and foreign.Frame.Position.X.Offset == 0)
		window.Search.Text = ""; settle()
		check("search restores original column", foreign.Frame.Parent == other.Page and foreign.Column == "Right" and foreign.Frame.Position.X.Offset > 0)
		window:SetSize(900, 610); settle()
		left:Detach(); settle()
		check("detached card keeps compact controls", left.Frame.Parent == left.FloatScroll and choice._compactLayout and choice.Field.Size.X.Scale == 1)
		left:Dock(); settle()
		check("docked card returns to its column", left.Frame.Parent == tab.Page and left.Frame.Position.X.Offset == 0 and left.Column == "Left")
		local before = left:_measureHeight(); choice:SetVisible(false); settle()
		check("hidden controls close column gaps", left:_measureHeight() < before and lower.Frame.Position.Y.Offset >= left:_measureHeight() + 15)
		local player = game:GetService("Players").LocalPlayer
		check("user display name is automatic", window.UserDisplayName.Text == player.DisplayName)
		check("username is automatic", window.UserName.Text == "@" .. player.Name)
		check("profile has an avatar surface", window.UserAvatar:IsA("ImageLabel") and window.UserAvatar.Parent.Name == "Avatar")
		check("profile card is anchored bottom left", window.UserCard.Position.Y.Scale == 1 and window.UserCard.Position.Y.Offset == -88 and window.UserCard.Size.Y.Offset == 64)
		check("footer no longer shows version", not string.find(window.Footer.Text, "PEARL", 1, true) and not string.find(window.Footer.Text, PearlUI.Version, 1, true))
		window:SetToggleKey("F4")
		check("shortcut hint updates without replacing profile", window.Footer.Text == "F4 / toggle" and window.UserDisplayName.Text == player.DisplayName)
		local token = window._profileToken; window:RefreshUserProfile()
		check("avatar refresh invalidates older requests", window._profileToken == token + 1)
		task.wait(0.2)
		check("loaded avatar clears fallback", not window.UserAvatar.IsLoaded or not window.AvatarFallback.Visible)
		local bad = window:GetLayout(); bad.Window.Columns = 3
		check("invalid columns rejected before applying", not window:ImportLayout(bad) and window.Columns == 2)
		window:Destroy(); task.wait(0.1)
		check("profile jobs and layout work clean up", window.Destroyed and next(window._jobs) == nil and window.UserCard.Parent == nil)
		return { passed = #checks, checks = checks }
	end)
	window:Destroy()
	if not ok then error(result) end
	return result
end
